# Copy this file to .env and fill in your keys.

# true = use sample headlines + fake summaries (no keys needed). Set false once keys are in.
MOCK=true

# https://gnews.io  (free key after sign-up)
GNEWS_API_KEY=

# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Countries users can pick in the app (GNews 2-letter codes), and which one opens first.
# Each enabled country costs ~18 AI calls per day.
COUNTRIES=us,in,gb,ca,au
DEFAULT_COUNTRY=us

# Languages the cards can be written in (en, hi, te, ta, es, fr, de), and the default.
# Each country+language pair is its own daily digest (~18 AI calls), built the first time someone picks it.
LANGUAGES=en,hi,te,es,fr
DEFAULT_LANGUAGE=en
# Headlines per category
PER_CATEGORY=3

PORT=4000
# When the daily digest is generated (cron syntax, server local time). Default 6:00 AM.
CRON_SCHEDULE=0 6 * * *
